# KnowOcean Python Backend — 环境变量模板
# 复制为 .env 并填入真实值

# ── 服务 ──
SERVER_HOST=0.0.0.0
SERVER_PORT=10001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEBUG=false

# ── 数据库 (PostgreSQL 16 + pgvector) ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=dd_rag
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password

# ── JWT 认证 ──
JWT_SECRET_KEY=change-me-to-a-32-byte-random-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_REFRESH_COOKIE_NAME=KnowOcean_DD_RAG_REFRESH_TOKEN
JWT_REFRESH_COOKIE_SECURE=false    # 生产 HTTPS 环境改为 true
JWT_REFRESH_COOKIE_SAME_SITE=lax

# ── AI 模型 (DashScope 兼容 OpenAI API) ──
DASHSCOPE_API_KEY=your_dashscope_api_key
OPENAI_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
AI_CHAT_MODEL=deepseek-v4-pro
AI_EMBEDDING_MODEL=text-embedding-v3
AI_EMBEDDING_DIMENSIONS=512

# ── Elasticsearch ──
ES_HOST=localhost
ES_PORT=9200
ES_SCHEME=http
ES_USERNAME=elastic
ES_PASSWORD=elastic
ES_INDEX_NAME=dd_rag_document_chunks

# ── MinIO 对象存储 ──
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowocean-rag-documents
MINIO_SECURE=false

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── 开发环境管理员 ──
DEV_ADMIN_ENABLED=true
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=Admin123456
DEV_ADMIN_EMAIL=admin@example.com

# ── Mock ETL ──
MOCK_ETL_ENABLED=true              # 生产环境应设为 false

# ── 日志 ──
LOG_LEVEL=INFO
